# Kopioi tämä tiedosto nimelle "secrets.env", täytä oikeat arvot,
# ja suojaa se välittömästi:
#
#   cp secrets.env.example secrets.env
#   nano secrets.env
#   chmod 600 secrets.env
#
# ÄLÄ jaa täytettyä secrets.env-tiedostoa kenellekään, äläkä
# committaa/lähetä sitä mihinkään (esim. sähköpostilla, USB-tikulla
# jonka joku muu näkee, tms).

export DISCORD_WEBHOOK_AIKATAULU="https://discord.com/api/webhooks/..."
export DISCORD_WEBHOOK_ANNOUNCE="https://discord.com/api/webhooks/..."
